{
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write"
  ],
  "lastChangelogVersion": "1.1.0",
  "quietStartup": true,
  "theme": "vitesse-light/vitesse-dark",
  "defaultProvider": "kimi-coding",
  "defaultModel": "k3-256k",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "kimi-coding/k3-256k",
    "kimi-coding/k3",
    "qwen-token-plan-cn/qwen3.8-max",
    "cloudflare-ai-gateway/dynamic/zhipu-flash",
    "cloudflare-ai-gateway/dynamic/zhipu",
    "antigravity/gemini-3.8-flash",
    "deepseek/deepseek-flash",
    "cloudflare-ai-gateway/dynamic/deepseek",
    "cloudflare-ai-gateway/DeepSeek-V4.1-Flash"
  ],
  "packages": [
    "git:github.com/shaonianche/pi-quotas@zai-code",
    "../../.funes/integrations/pi",
    "npm:pi-antigravity",
    "npm:context-mode"
  ],
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "compaction": {
    "enabled": true,
    "reserveTokens": 49152,
    "keepRecentTokens": 12000
  }
}