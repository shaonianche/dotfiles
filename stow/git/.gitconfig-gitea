# Loaded automatically for repos whose remote URL matches **/tonghuiai.cn*/**
# (see the includeIf block in ~/.gitconfig).
#
# Gitea verifies against its own registered key, so the device default key
# must not sign here. Commits stay unsigned unless this device can reach the
# Gitea signing key.

[user]
name = duanfei
# Gitea privacy (noreply) email for this instance.
email = 12+duanfei@noreply.tonghuiai.cn

[commit]
gpgsign = false

# The Gitea signing key lives in 1Password. A device whose ssh-agent
# (SSH_AUTH_SOCK) serves it creates this file:
#   [user]
#   signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINFuQZ8ROH6jIzID29hf7WpPAev6fWljT6N9jd5nRvpa
#   [commit]
#   gpgsign = true
[include]
path = ~/.gitconfig-gitea.local
