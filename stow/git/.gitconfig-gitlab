# Loaded automatically for repos whose remote URL matches **/gitlab.com*/**
# (see the includeIf block in ~/.gitconfig).
#
# GitLab verifies against its own registered key, so the device default key
# must not sign here. Commits stay unsigned unless this device can reach the
# GitLab signing key.

[user]
# GitLab noreply email (keeps the real address private).
email = 7479409-shaonianche@users.noreply.gitlab.com

[commit]
gpgsign = false

# The GitLab signing key lives in 1Password. A device whose ssh-agent
# (SSH_AUTH_SOCK) serves it creates this file:
#   [user]
#   signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIE7bgeNGA5Ihly8RZUj0Ew+6qTiSkwocTOBNngA/AumM
#   [commit]
#   gpgsign = true
[include]
path = ~/.gitconfig-gitlab.local
